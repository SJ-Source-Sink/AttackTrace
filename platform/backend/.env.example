# ─────────────────────────────────────────────────────────────
# AttackTrace — Environment Variable Reference
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# Application
APP_NAME="AttackTrace"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# Security — change ALL of these before production deployment
SECRET_KEY=CHANGE_ME_32_CHAR_RANDOM_HEX_STRING_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption key for OrgCredentials (must be 32+ bytes, any string)
# Used with SHA-256 derivation → Fernet AES-256
KMS_MASTER_KEY=CHANGE_ME_GENERATE_WITH_python_secrets_token_hex_32

# Database — PostgreSQL 16
# Async URL for the application
DATABASE_URL=postgresql+asyncpg://attacktrace:attacktrace@localhost:5432/attacktrace
# Sync URL for Alembic migrations (uses psycopg2 instead of asyncpg)
SYNC_DATABASE_URL=postgresql://attacktrace:attacktrace@localhost:5432/attacktrace
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_SCAN_PUBSUB_DB=1

# CORS — comma-separated origins for the Next.js frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# Celery (uses Redis as broker)
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3
CELERY_TASK_SOFT_TIME_LIMIT=7200
CELERY_TASK_TIME_LIMIT=7800

# Anthropic AI (optional — AI features disabled if not set)
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-haiku-4-5-20251001
AI_MAX_TOKENS=2048

# AttackTrace workspace directory for scan output and reports
ATTACKTRACE_WORKSPACE_DIR=/tmp/attacktrace_scans

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
