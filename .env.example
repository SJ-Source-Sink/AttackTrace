# ─── AttackTrace — Environment Variables ────────────────────────────────────
#
# Copy this file to .env and fill in real values before running docker-compose.
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
# Generate a strong SECRET_KEY:  openssl rand -hex 32
# Generate a strong KMS key:     openssl rand -base64 32

# ─── Database ─────────────────────────────────────────────────────────────────
# Async URL used by FastAPI/SQLAlchemy at runtime
DATABASE_URL=postgresql+asyncpg://attacktrace:attacktrace@postgres:5432/attacktrace
# Sync URL used by Alembic migrations (asyncpg driver not supported by Alembic)
SYNC_DATABASE_URL=postgresql://attacktrace:attacktrace@postgres:5432/attacktrace
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ────────────────────────────────────────────────────────────────────
# DB 0 — general cache / pub-sub for scan progress websockets
REDIS_URL=redis://redis:6379/0
# DB 1 — Celery task broker
CELERY_BROKER_URL=redis://redis:6379/1
# DB 2 — Celery result backend
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Security ─────────────────────────────────────────────────────────────────
# MUST be changed in production — used to sign JWTs
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# 32-byte base64-encoded master key for symmetric credential encryption (KMS)
KMS_MASTER_KEY=change-me-32-bytes-base64-encoded=

# ─── Anthropic AI ─────────────────────────────────────────────────────────────
# Obtain from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-haiku-4-5-20251001
AI_MAX_TOKENS=2048

# ─── MSRA — Mobile Security Review Assistant ──────────────────────────────────
# URL of the MSRA sidecar service. Docker: http://msra:5001  Native: http://localhost:5001
MSRA_URL=http://msra:5001

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
# Initial superuser created on first startup (see app.initial_data)
# Default login: username=admin  password=Ihate13$
FIRST_SUPERUSER_EMAIL=admin
FIRST_SUPERUSER_PASSWORD=Ihate13$

# ─── Celery task limits ───────────────────────────────────────────────────────
# Scans can run a long time; these are safety valves
CELERY_TASK_SOFT_TIME_LIMIT=7200
CELERY_TASK_TIME_LIMIT=7800

# ─── AttackTrace CLI ─────────────────────────────────────────────────────────────────
# Temp workspace that workers write scan artifacts to before uploading to DB
ATTACKTRACE_WORKSPACE_DIR=/tmp/attacktrace_scans

# ─── Frontend (exposed to the browser) ────────────────────────────────────────
# Public base URL for Next.js client-side API calls (baked into the JS bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Internal URL for Next.js server-side API rewrites — read by next.config.ts
# Docker: http://backend:8000   Native: http://localhost:8000
BACKEND_URL=http://backend:8000
